<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="im_livechat_channel_view_form_inherit_whatsapp" model="ir.ui.view">
        <field name="name">im_livechat.channel.form.whatsapp</field>
        <field name="model">im_livechat.channel</field>
        <field name="inherit_id" ref="im_livechat.im_livechat_channel_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page string="WhatsApp" name="whatsapp">
                    <group>
                        <group string="WhatsApp Integration">
                            <field name="whatsapp_gateway_id"/>
                            <field name="whatsapp_chatbot_script_id"/>
                        </group>
                    </group>
                    <div class="text-muted mt8" invisible="not whatsapp_gateway_id">
                        When a WhatsApp gateway is linked, incoming WhatsApp
                        messages will be routed through this livechat channel.
                        Operators will receive messages in Discuss and can
                        respond directly.
                    </div>
                    <div class="text-muted mt8" invisible="not whatsapp_chatbot_script_id">
                        On the first WhatsApp contact the bot sends the
                        script's welcome steps and its first question, with
                        the answer options as WhatsApp interactive buttons.
                        The conversation is mirrored to the gateway channel so
                        attendants can follow along and take over at any time.
                    </div>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
