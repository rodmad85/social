<odoo>
    <record id="view_purchase_order_form_whatsapp_send" model="ir.ui.view">
        <field name="name">purchase.order.form.whatsapp.send</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_form" />
        <field name="arch" type="xml">
            <xpath expr="//header/button[@name='action_rfq_send'][1]" position="after">
                <button
                    name="action_send_whatsapp"
                    string="Send by WhatsApp"
                    type="object"
                    invisible="state not in ('draft', 'sent', 'purchase')"
                />
            </xpath>
        </field>
    </record>
</odoo>
