<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record model="ir.ui.view" id="discuss_channel_unassigned_tree_view">
        <field name="name">discuss.channel.unassigned.tree</field>
        <field name="model">discuss.channel</field>
        <field name="arch" type="xml">
            <list>
                <field name="name" />
                <field name="gateway_channel_token" string="Phone" />
                <field name="gateway_id" />
                <field name="is_unassigned" invisible="1" />
                <button
                    name="action_claim"
                    type="object"
                    string="Assumir Conversa"
                    class="btn-primary"
                />
            </list>
        </field>
    </record>

    <record model="ir.ui.view" id="discuss_channel_transfer_tree_view">
        <field name="name">discuss.channel.transfer.pending.tree</field>
        <field name="model">discuss.channel</field>
        <field name="arch" type="xml">
            <list>
                <field name="name" string="Contato" />
                <field name="gateway_channel_token" string="Telefone" />
                <field name="transfer_target_user_id" string="Transferir para" />
                <field name="transfer_requested_by" string="Solicitado por" />
                <field name="transfer_requested_date" string="Data" />
                <field name="transfer_message" optional="show" />
                <button
                    name="action_approve_transfer"
                    type="object"
                    string="Aprovar"
                    class="btn-success"
                />
                <button
                    name="action_reject_transfer"
                    type="object"
                    string="Rejeitar"
                    class="btn-danger"
                />
            </list>
        </field>
    </record>

    <record model="ir.actions.act_window" id="action_pending_transfers">
        <field name="name">Transferências Pendentes</field>
        <field name="res_model">discuss.channel</field>
        <field name="view_mode">list</field>
        <field name="domain">[('channel_type', '=', 'gateway'), ('transfer_state', '=', 'pending')]</field>
        <field name="context">{}</field>
    </record>

    <menuitem
        id="menu_pending_transfers"
        name="Transferências Pendentes"
        parent="menu_mail_whatsapp_messages_root"
        action="action_pending_transfers"
        sequence="98"
        groups="base.group_system"
    />
</odoo>
