<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record model="ir.ui.view" id="discuss_channel_transfer_form_view">
        <field name="name">discuss.channel.transfer.form</field>
        <field name="model">discuss.channel</field>
        <field name="inherit_id" ref="mail.discuss_channel_view_form" />
        <field name="arch" type="xml">
            <xpath expr="//sheet/group[last()]" position="after">
                <group string="Transferência de Conversa" groups="mail_gateway.gateway_user">
                    <field name="transfer_state" widget="badge" decoration-success="transfer_state == 'approved'" decoration-warning="transfer_state == 'pending'" decoration-danger="transfer_state == 'rejected'" />
                    <field name="transfer_target_user_id" />
                    <field name="transfer_requested_by" />
                    <field name="transfer_requested_date" />
                    <field name="transfer_message" />
                    <button
                        name="action_request_transfer"
                        type="object"
                        string="Solicitar Transferência"
                        class="btn-warning"
                        invisible="transfer_state not in [False, 'rejected']"
                    />
                    <button
                        name="action_approve_transfer"
                        type="object"
                        string="Aprovar"
                        class="btn-success"
                        groups="base.group_system"
                        invisible="transfer_state != 'pending'"
                    />
                    <button
                        name="action_reject_transfer"
                        type="object"
                        string="Rejeitar"
                        class="btn-danger"
                        groups="base.group_system"
                        invisible="transfer_state != 'pending'"
                    />
                </group>
            </xpath>
        </field>
    </record>
</odoo>
