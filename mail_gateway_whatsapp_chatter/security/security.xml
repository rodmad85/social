<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="mail_gateway.discuss_channel_gateway_rule" model="ir.rule">
        <field name="name">discuss.channel: access gateway (restricted)</field>
        <field name="model_id" ref="mail.model_discuss_channel" />
        <field name="groups" eval="[(4, ref('mail_gateway.gateway_user'))]" />
        <field name="domain_force">[('channel_type', '=', 'gateway'), ('channel_member_ids.partner_id', '=', user.partner_id.id)]</field>
        <field name="perm_read" eval="True" />
        <field name="perm_create" eval="False" />
        <field name="perm_write" eval="True" />
        <field name="perm_unlink" eval="False" />
    </record>

    <record id="mail_gateway.ir_rule_discuss_channel_partner_group_user" model="ir.rule">
        <field name="name">discuss.channel.member: read members of gateway channels</field>
        <field name="model_id" ref="mail.model_discuss_channel_member" />
        <field name="groups" eval="[(4, ref('mail_gateway.gateway_user'))]" />
        <field name="domain_force">[('channel_id.channel_type', '=', 'gateway')]</field>
        <field name="perm_read" eval="True" />
        <field name="perm_write" eval="False" />
        <field name="perm_create" eval="False" />
        <field name="perm_unlink" eval="False" />
    </record>

    <record id="ir_rule_discuss_channel_member_manage_own_gateway" model="ir.rule">
        <field name="name">discuss.channel.member: manage own entries on gateway channels</field>
        <field name="model_id" ref="mail.model_discuss_channel_member" />
        <field name="groups" eval="[(4, ref('mail_gateway.gateway_user'))]" />
        <field name="domain_force">[('channel_id.channel_type', '=', 'gateway'), ('is_self', '=', True)]</field>
        <field name="perm_read" eval="False" />
        <field name="perm_write" eval="True" />
        <field name="perm_create" eval="False" />
        <field name="perm_unlink" eval="True" />
    </record>
</odoo>
