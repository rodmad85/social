<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record model="ir.ui.view" id="discuss_channel_unassigned_tree_view">
        <field name="name">discuss.channel.unassigned.tree</field>
        <field name="model">discuss.channel</field>
        <field name="arch" type="xml">
            <list>
                <field name="name" />
                <field name="gateway_channel_token" string="Phone" />
                <field name="gateway_id" />
                <field name="is_unassigned" invisible="1" />
                <button
                    name="action_claim"
                    type="object"
                    string="Assumir Conversa"
                    class="btn-primary"
                />
            </list>
        </field>
    </record>

    <record model="ir.actions.act_window" id="action_unassigned_channels">
        <field name="name">Conversas Não Atribuídas</field>
        <field name="res_model">discuss.channel</field>
        <field name="view_mode">tree</field>
        <field name="domain">[('channel_type', '=', 'gateway'), ('is_unassigned', '=', True)]</field>
        <field name="context">{}</field>
    </record>

    <record model="ir.ui.menu" id="menu_unassigned_channels">
        <field name="name">Não Atribuídas</field>
        <field name="parent_id" ref="mail_gateway.mail_gateway_menu" />
        <field name="action" ref="action_unassigned_channels" />
        <field name="sequence" eval="99" />
    </record>

    <record model="ir.ui.view" id="discuss_channel_transfer_form_view">
        <field name="name">discuss.channel.transfer.form</field>
        <field name="model">discuss.channel</field>
        <field name="inherit_id" ref="discuss.discuss_channel_view_form" />
        <field name="arch" type="xml">
            <xpath expr="//sheet/group[last()]" position="after">
                <group string="Transferência de Conversa" groups="mail_gateway.gateway_user">
                    <field name="transfer_state" widget="badge" decoration-success="transfer_state == 'approved'" decoration-warning="transfer_state == 'pending'" decoration-danger="transfer_state == 'rejected'" />
                    <field name="transfer_target_user_id" />
                    <field name="transfer_requested_by" />
                    <field name="transfer_requested_date" />
                    <field name="transfer_message" />
                    <button
                        name="action_request_transfer"
                        type="object"
                        string="Solicitar Transferência"
                        class="btn-warning"
                        invisible="transfer_state not in [False, 'rejected']"
                    />
                    <button
                        name="action_approve_transfer"
                        type="object"
                        string="Aprovar"
                        class="btn-success"
                        groups="base.group_system"
                        invisible="transfer_state != 'pending'"
                    />
                    <button
                        name="action_reject_transfer"
                        type="object"
                        string="Rejeitar"
                        class="btn-danger"
                        groups="base.group_system"
                        invisible="transfer_state != 'pending'"
                    />
                </group>
            </xpath>
        </field>
    </record>

    <record model="ir.ui.view" id="discuss_channel_transfer_tree_view">
        <field name="name">discuss.channel.transfer.pending.tree</field>
        <field name="model">discuss.channel</field>
        <field name="arch" type="xml">
            <list>
                <field name="name" string="Contato" />
                <field name="gateway_channel_token" string="Telefone" />
                <field name="transfer_target_user_id" string="Transferir para" />
                <field name="transfer_requested_by" string="Solicitado por" />
                <field name="transfer_requested_date" string="Data" />
                <field name="transfer_message" optional="show" />
                <button
                    name="action_approve_transfer"
                    type="object"
                    string="Aprovar"
                    class="btn-success"
                />
                <button
                    name="action_reject_transfer"
                    type="object"
                    string="Rejeitar"
                    class="btn-danger"
                />
            </list>
        </field>
    </record>

    <record model="ir.actions.act_window" id="action_pending_transfers">
        <field name="name">Transferências Pendentes</field>
        <field name="res_model">discuss.channel</field>
        <field name="view_mode">tree</field>
        <field name="domain">[('channel_type', '=', 'gateway'), ('transfer_state', '=', 'pending')]</field>
        <field name="context">{}</field>
    </record>

    <record model="ir.ui.menu" id="menu_pending_transfers">
        <field name="name">Transferências Pendentes</field>
        <field name="parent_id" ref="mail_gateway.mail_gateway_menu" />
        <field name="action" ref="action_pending_transfers" />
        <field name="sequence" eval="98" />
        <field name="groups" eval="[(4, ref('base.group_system'))]" />
    </record>
</odoo>
