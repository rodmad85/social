<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record model="ir.ui.view" id="discuss_channel_transfer_wizard_form_view">
        <field name="name">discuss.channel.transfer.wizard.form</field>
        <field name="model">discuss.channel.transfer.wizard</field>
        <field name="arch" type="xml">
            <form>
                <group>
                    <field name="channel_name" string="Conversa" readonly="1" />
                    <field name="target_user_id" />
                    <field name="message" placeholder="Informe o motivo da transferência..." />
                </group>
                <footer>
                    <button
                        name="action_submit"
                        type="object"
                        string="Solicitar"
                        class="btn-primary"
                    />
                    <button
                        string="Cancelar"
                        class="btn-secondary"
                        special="cancel"
                    />
                </footer>
            </form>
        </field>
    </record>
</odoo>
