<?xml version="1.0" encoding="utf-8" ?>
<odoo noupdate="1">
    <record id="ir_cron_whatsapp_notification" model="ir.cron">
        <field name="name">WhatsApp: Schedule and Send Template Notifications</field>
        <field name="model_id" ref="model_whatsapp_notification" />
        <field name="state">code</field>
        <field name="code">model._cron_process_notifications()</field>
        <field name="user_id" ref="base.user_root" />
        <field name="interval_number">15</field>
        <field name="interval_type">minutes</field>
        <field name="numbercall">-1</field>
    </record>
</odoo>
