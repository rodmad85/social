<?xml version="1.0" encoding="UTF-8" ?>
<templates xml:space="preserve">

    <t t-inherit="web.PhoneField" t-inherit-mode="extension">
        <xpath expr="//div[hasclass('o_phone_content')]//a" position="after">
            <t t-if="props.enableCallButton and props.record.data[props.name]">
                <SendWhatsappCallButton t-props="props" />
            </t>
        </xpath>
    </t>

    <t t-inherit="web.FormPhoneField" t-inherit-mode="extension">
        <xpath expr="//a[hasclass('o_phone_form_link')]" position="replace">
            <t t-if="props.enableCallButton and props.record.data[props.name]">
                <SendWhatsappCallButton t-props="props" />
            </t>
        </xpath>
    </t>

</templates>
